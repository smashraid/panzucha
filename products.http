@token = 


### Get all products
# @name products
# @description get all products from table products
GET http://localhost:8080/api/v1/products
User-Agent: resterm
Accept: application/json 
Authorization: Bearer {{token}}

### Create a product
# @name products
# @description create a new product
POST http://localhost:8080/api/v1/products
Content-Type: application/json 
Authorization: Bearer {{token}}

{
    "name":"Lenovo ThinkPad X1 Carbon 11ra Gen (14 inch Intel)",
    "description": "Con certificación Intel® Evo™ con CPU Intel® Core™ vPro® de hasta 13ra generación",
    "price": 1999.99,
    "stock": 10
}