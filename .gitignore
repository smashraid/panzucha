# Compiled Object files, Global libraries, Word lists, etc.
*.a
*.o
*.6
*.8

# Compiled binaries
# You can also use a specific directory like bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the # if you want to ignore vendor/)
# vendor/

# Local environment files
.env
.env.local

# IDE/Editor specific files
.vscode/
.idea/
*.swp
*.swo
